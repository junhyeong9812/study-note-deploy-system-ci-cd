# --- .env.master (master 역할 호스트)
#MODE=master
#PORT=15000
#DEPLOY_SECRET=<random-hex>
#LOG_REDIS_URL=redis://<backend-host>:6379
#SERVER_NAME=ci-master
#AGENT_URL_FRONT=http://<host9>:15001
#AGENT_URL_BACKEND=http://<host158>:15001
#AGENT_URL_LLM=http://<host164>:15001

# --- .env.agent (모든 호스트)
#MODE=agent
#DEPLOY_SECRET=<same-hex>
#LOG_REDIS_URL=redis://<backend-host>:6379
#SERVER_NAME=ci-agent-<host>
#DEPLOY_DIR_LLM=/home/<user>/study-note-deploy-system-llm
#DEPLOY_SVC_LLM=wrapper
#DEPLOY_HEALTH_LLM=http://127.0.0.1:8000/health
#DEPLOY_TEST_CONTEXT_LLM=wrapper       # `docker build --target test` 경로(배포 디렉토리 기준, 기본 ".")
# 서비스마다 DEPLOY_DIR_·DEPLOY_SVC_·DEPLOY_HEALTH_ 셋이 모두 있어야 한다.
#   DEPLOY_SVC_ 가 없으면 CI·CD 를 거절한다(compose 전체가 대상이 되는 것을 막는다).
#   DEPLOY_HEALTH_ 가 없으면 CD 를 거절한다(확인 못 한 배포를 성공이라 하지 않는다).

# --- 무중단 배포(blue/green)로 옮긴 서비스만
#DEPLOY_MODE_BACKEND=bluegreen
#DEPLOY_HEALTH_BACKEND=http://<LAN 주소>:8090/actuator/health        # nginx 경유 — 응답의 X-Deploy-Slot 으로 자리 판정
#DEPLOY_HEALTH_BACKEND_BLUE=http://127.0.0.1:18090/actuator/health
#DEPLOY_HEALTH_BACKEND_GREEN=http://127.0.0.1:18091/actuator/health
#DEPLOY_DRAIN_LLM_BLUE=…                # 선택 — 구 자리에 정리 시작을 알린다(POST)

# --- 알림 서버 연동(master·agent 공통, 선택) — 비우면 보내지 않는다
#ALERT_EVENTS_URL=http://<알림 서버 LAN 주소>:16000/events   # 배포 실패·두 자리가 남았을 수 있는 상황을 알린다
#ALERT_SECRET=…                                              # 알림 서버의 ALERT_SECRET 과 같은 값
# --- 알림 서버도 배포 대상이다(무중단 배포)
# master:
#AGENT_URL_ALERT=http://<알림 서버가 있는 호스트>:15001
# 알림 서버가 있는 호스트의 agent:
#DEPLOY_DIR_ALERT=${HOME}/study-note-deploy-system-alert
#DEPLOY_SVC_ALERT=alert
#DEPLOY_MODE_ALERT=bluegreen
#DEPLOY_HEALTH_ALERT=http://<LAN 주소>:16000/health
#DEPLOY_HEALTH_ALERT_BLUE=http://127.0.0.1:16001/health
#DEPLOY_HEALTH_ALERT_GREEN=http://127.0.0.1:16002/health
#DEPLOY_DRAIN_ALERT_BLUE=http://127.0.0.1:16001/admin/drain    # 구 자리가 전환 즉시 감시를 내려놓게 한다
#DEPLOY_DRAIN_ALERT_GREEN=http://127.0.0.1:16002/admin/drain   #   (없어도 구 자리가 30초 안에 스스로 내려놓는다)
