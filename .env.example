# --- .env.master (master 역할 호스트)
#MODE=master
#PORT=15000
#DEPLOY_SECRET=<random-hex>
#LOG_REDIS_URL=redis://<backend-host>:6379
#SERVER_NAME=ci-master
#AGENT_URL_FRONT=http://<host9>:15001
#AGENT_URL_BACKEND=http://<host158>:15001
#AGENT_URL_LLM=http://<host164>:15001

# --- .env.agent (모든 호스트)
#MODE=agent
#DEPLOY_SECRET=<same-hex>
#LOG_REDIS_URL=redis://<backend-host>:6379
#SERVER_NAME=ci-agent-<host>
#DEPLOY_DIR_LLM=/home/<user>/study-note-deploy-system-llm
#DEPLOY_SVC_LLM=wrapper
#DEPLOY_HEALTH_LLM=http://127.0.0.1:8000/health
